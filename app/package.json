{
  "name": "@parallax/app",
  "version": "0.1.1",
  "description": "Desktop workspace for Parallax",
  "author": "Akshith Garapati",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "electron . --dev",
    "dev:web": "PARALLAX_NEXT_DIST_DIR=.next-test next dev -p 3100",
    "start": "electron .",
    "test": "pnpm run test:syntax && pnpm run test:node && pnpm run test:unit && pnpm run test:component && pnpm run test:integration && pnpm run test:workflow",
    "test:syntax": "node --check main.js && node --check preload.js && node --check preview-preload.js",
    "test:node": "node --test test/*.test.js",
    "test:unit": "vitest run test/*.test.ts",
    "test:component": "vitest run test/component",
    "test:integration": "vitest run test/integration",
    "test:workflow": "playwright test",
    "typecheck": "tsc --noEmit --incremental false",
    "verify": "pnpm test && pnpm run typecheck && pnpm run build",
    "build": "PARALLAX_NEXT_DIST_DIR=.next-build next build",
    "export": "PARALLAX_STATIC_EXPORT=1 PARALLAX_NEXT_DIST_DIR=.next-build next build",
    "package:mac": "pnpm run export && electron-builder --config electron-builder.config.js --mac --publish never",
    "release:mac": "pnpm run export && electron-builder --config electron-builder.config.js --mac --universal --publish always",
    "verify:release-tag": "node scripts/verify-release-tag.js",
    "verify:release-env": "node scripts/verify-release-environment.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "highlight.js": "^11.11.1",
    "jsdom": "^29.1.1",
    "katex": "^0.17.0",
    "next": "^14.2.35",
    "postcss": "^8.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  }
}
